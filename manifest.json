{
  "manifest_version": 3,
  "name": "D7 Admin Proxy UI",
  "version": "0.1.0",
  "description": "A modern React/Tailwind interface for legacy Drupal 7 administration.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.columbiadoctors.org/admin/*",
    "*://*.columbiadoctors.org/node/*",
    "*://*.columbia.edu/admin/*",
    "*://*.columbia.edu/node/*",
    "*://demo-ps-chai.pantheonsite.io/admin/*",
    "*://demo-ps-chai.pantheonsite.io/node/*",
    "*://demo-doctors-chai.pantheonsite.io/admin/*",
    "*://demo-doctors-chai.pantheonsite.io/node/*",
    "*://demo-dean-cuimc-chai.pantheonsite.io/admin/*",
    "*://demo-dean-cuimc-chai.pantheonsite.io/node/*",
    "*://neil-doctors-chai.pantheonsite.io/admin/*",
    "*://neil-doctors-chai.pantheonsite.io/node/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "js": [
        "src/content/index.tsx"
      ],
      "matches": [
        "*://*.columbiadoctors.org/admin/*",
        "*://*.columbiadoctors.org/node/*",
        "*://*.columbia.edu/admin/*",
        "*://*.columbia.edu/node/*",
        "*://demo-ps-chai.pantheonsite.io/admin/*",
        "*://demo-ps-chai.pantheonsite.io/node/*",
        "*://demo-doctors-chai.pantheonsite.io/admin/*",
        "*://demo-doctors-chai.pantheonsite.io/node/*",
        "*://demo-dean-cuimc-chai.pantheonsite.io/admin/*",
        "*://demo-dean-cuimc-chai.pantheonsite.io/node/*",
        "*://neil-doctors-chai.pantheonsite.io/admin/*",
        "*://neil-doctors-chai.pantheonsite.io/node/*",
        "file://*/*"
      ]
    }
  ]
}
